<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
  <TextView android:id="@+id/status" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="WordPop" android:textColor="#BCC5D5" android:textSize="11sp"/>
  <TextView android:id="@+id/open" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="打开" android:padding="4dp" android:textColor="#8AC9FF" android:textSize="12sp"/>
 </LinearLayout>
 <TextView android:id="@+id/word" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="WordPop" android:textColor="#82BAFF" android:textSize="26sp" android:textStyle="bold" android:gravity="center" android:maxLines="2" android:ellipsize="end"/>
 <TextView android:id="@+id/phonetic" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#BBC7DD" android:textSize="12sp" android:gravity="center" android:maxLines="1"/>
 <TextView android:id="@+id/translation" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="点击显示释义" android:textSize="14sp" android:textColor="#F2F4F8" android:maxLines="3" android:ellipsize="end"/>
 <LinearLayout android:id="@+id/ratings" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
  <TextView android:id="@+id/unknown" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="不认识" android:textColor="#FFAAAA" android:textSize="12sp" android:gravity="center"/>
  <TextView android:id="@+id/fuzzy" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="模糊" android:textColor="#FFD799" android:textSize="12sp" android:gravity="center"/>
  <TextView android:id="@+id/known" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="认识" android:textColor="#A4E8C4" android:textSize="12sp" android:gravity="center"/>
  <TextView android:id="@+id/easy" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="轻松" android:textColor="#D4B7FF" android:textSize="12sp" android:gravity="center"/>
 </LinearLayout>
</LinearLayout>
