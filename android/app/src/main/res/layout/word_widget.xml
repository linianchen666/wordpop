<?xml version="1.0" ?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
  <ImageView android:id="@+id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_background" android:scaleType="fitXY" android:importantForAccessibility="no"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <TextView android:shadowColor="#C0000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="3" android:id="@+id/status" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="WordPop" android:textColor="#BCC5D5" android:textSize="11sp"/>
      <TextView android:shadowColor="#C0000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="3" android:id="@+id/appearance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="背景" android:padding="4dp" android:textColor="#8AC9FF" android:textSize="12sp"/>
      <TextView android:shadowColor="#C0000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="3" android:id="@+id/open" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="打开" android:padding="4dp" android:textColor="#8AC9FF" android:textSize="12sp"/>
      <TextView android:shadowColor="#C0000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="3" android:id="@+id/easy" android:layout_width="42dp" android:layout_height="wrap_content" android:paddingTop="2dp" android:paddingBottom="2dp" android:text="★" android:textColor="#D4B7FF" android:textSize="13sp" android:gravity="center" android:contentDescription="轻松"/>
    </LinearLayout>
    <TextView android:shadowColor="#C0000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="3" android:id="@+id/word" android:layout_width="match_parent" android:layout_height="44dp" android:text="WordPop" android:textColor="#82BAFF" android:textSize="26sp" android:textStyle="bold" android:gravity="center" android:maxLines="2" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="30sp" android:autoSizeStepGranularity="1sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal">
      <TextView android:shadowColor="#C0000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="3" android:id="@+id/phonetic" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:textColor="#BBC7DD" android:textSize="12sp" android:gravity="center" android:maxLines="1"/>
      <TextView android:shadowColor="#C0000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="3" android:id="@+id/speak" android:layout_width="64dp" android:layout_height="40dp" android:gravity="center" android:text="🔊 发音" android:contentDescription="播放当前单词英语发音" android:textColor="#BCCFFF" android:textSize="13sp"/>
    </LinearLayout>
    <TextView android:shadowColor="#C0000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="3" android:id="@+id/translation" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="点击显示释义" android:textSize="14sp" android:textColor="#F2F4F8" android:maxLines="3" android:ellipsize="end"/>
    <LinearLayout android:id="@+id/ratings" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
      <TextView android:shadowColor="#C0000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="3" android:id="@+id/unknown" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="不认识" android:textColor="#FFAAAA" android:textSize="12sp" android:gravity="center"/>
      <TextView android:shadowColor="#C0000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="3" android:id="@+id/fuzzy" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="模糊" android:textColor="#FFD799" android:textSize="12sp" android:gravity="center"/>
      <TextView android:shadowColor="#C0000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="3" android:id="@+id/known" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="认识" android:textColor="#A4E8C4" android:textSize="12sp" android:gravity="center"/>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
